// Cloudflare Workers (static assets) configuration for Willowfield.
// Build: `npm run build` (node build.mjs) writes the site to ./dist; `npx wrangler deploy` uploads it.
// _headers and _redirects in dist/ are applied by Cloudflare.
{
  "name": "willowfield",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
